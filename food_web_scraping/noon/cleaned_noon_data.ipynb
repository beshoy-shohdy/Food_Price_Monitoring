import pandas as pd

url = "https://raw.githubusercontent.com/beshoy-shohdy/Food_Price_Monitoring/refs/heads/main/food_web_scraping/noon/noon_products.csv"

df = pd.read_csv(url)

df.head()
df = df[df["sku"].notna()]
df["unit_count"] = df["unit_count"].fillna(1)
df.drop(
