    inplace=True,
    errors="ignore"
)
df["date"] = pd.to_datetime(df["date"], errors="coerce")
text_cols = df.select_dtypes(include="object").columns

for col in text_cols:
    df[col] = df[col].str.lower().str.strip()
df.drop_duplicates(inplace=True)
for col in text_cols:
